// Prisma schema for AI-Powered Data Intelligence Platform (production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id            String   @id @default(cuid())
  title         String
  prompt        String
  status        String   @default("planned") // planned | running | completed | failed
  objective     String?
  fields        String? // JSON: array of { name, type, description }
  searchQueries String? // JSON: array of strings
  sourceStrategy String? // JSON: array of strings (domains / site hints)
  validationRules String? // JSON: array of strings
  tags          String? // JSON: array of strings
  workflow      String? // JSON: array of { id, name, status, detail }
  progress      String? // JSON: { step, message, current, total }
  stats         String? // JSON: { items, sources, valid, duplicates, tokens }
  error         String?
  // Production: scheduling, soft-delete, pinning
  schedule      String? // JSON: { enabled, intervalMinutes, nextRunAt, lastRunAt } | null
  pinned        Boolean  @default(false)
  trashedAt     DateTime? // soft-delete: when set, task is in trash
  // Run lease. startedAt is set when a run claims the task; a run whose lease is
  // older than STALE_RUN_MS is considered dead (crash, redeploy, HMR) and is
  // reclaimed by the reaper instead of blocking the task forever.
  startedAt     DateTime?
  runToken      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dataItems   DataItem[]
  sources     DataSource[]
  activity    ActivityLog[]
  template    Template?  @relation(fields: [templateId], references: [id])
  templateId  String?

  @@index([status])
  @@index([createdAt])
  @@index([trashedAt])
  @@index([pinned])
}

model DataItem {
  id          String   @id @default(cuid())
  taskId      String
  data        String   // JSON: structured fields
  title       String?
  summary     String?
  confidence  Float    @default(0)
  valid       Boolean  @default(true)
  dedupeKey   String?
  sourceId    String?
  createdAt   DateTime @default(now())

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  source      DataSource? @relation(fields: [sourceId], references: [id])

  @@index([taskId])
  @@index([dedupeKey])
}

model DataSource {
  id          String   @id @default(cuid())
  taskId      String
  url         String
  title       String?
  snippet     String?
  hostName    String?
  favicon     String?
  publishedTime String?
  rank        Int      @default(0)
  contentExcerpt String?
  fetchStatus String   @default("pending") // pending | fetched | failed
  tokensUsed  Int      @default(0)
  fetchedAt   DateTime?
  createdAt   DateTime @default(now())

  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dataItems   DataItem[]

  @@index([taskId])
  @@index([hostName])
}

// Reusable prompt + schema templates
model Template {
  id          String   @id @default(cuid())
  name        String
  prompt      String
  fields      String?  // JSON: array of FieldDef
  tags        String?  // JSON: array of strings
  icon        String?
  isBuiltIn   Boolean  @default(false)
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]

  @@index([isBuiltIn])
}

// Audit trail — track every meaningful action
model ActivityLog {
  id          String   @id @default(cuid())
  taskId      String?
  type        String   // task_created | task_run | task_completed | task_failed | task_deleted | task_pinned | task_restored | task_scheduled | template_saved | export
  message     String
  meta        String?  // JSON: extra context
  createdAt   DateTime @default(now())

  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([type])
  @@index([createdAt])
}

// App-wide settings (single row, keyed by singleton)
model Setting {
  id          String   @id @default("singleton")
  preferences String   @default("{}") // JSON: { defaultSort, defaultDateRange, semanticByDefault, exportFormat, autoSchedule, theme }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
