# Copy to .env and fill in. Never commit .env.

# SQLite file. Relative paths resolve against prisma/schema.prisma, so from the
# repo root use file:../db/custom.db
DATABASE_URL=file:../db/custom.db

# Shared secret for /api/scheduler/tick and /api/scheduler/purge-trash.
# The scheduler is DISABLED while this is unset - generate a real value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULER_KEY=

# Same value, exposed to the browser so the client can poll the scheduler tick.
# NOTE: anything in NEXT_PUBLIC_* ships in the JS bundle and is readable by any
# visitor. Trigger the scheduler from cron/launchd in production instead of
# relying on browser polling.
NEXT_PUBLIC_SCHEDULER_KEY=