# Copy to .env and fill in. Never commit .env.

# Single-tenant access token. The ENTIRE /api surface is gated on this: exchange
# it for an httpOnly session cookie via POST /api/auth/login. While it is unset
# the API returns 503 and the UI shows "Authentication not configured" - it never
# falls back to a default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_TOKEN=

# SQLite file. Relative paths resolve against prisma/schema.prisma, so from the
# repo root use file:../db/custom.db
DATABASE_URL=file:../db/custom.db

# Shared secret for /api/scheduler/tick and /api/scheduler/purge-trash.
# Server-side ONLY. The browser deliberately does not hold this key - run
# scripts/scheduler-tick.sh from cron or launchd instead (see the header of that
# script). The scheduler is DISABLED while this is unset - the endpoints return
# 503, they do not fall back to a default.
SCHEDULER_KEY=