# Copy to .env and fill in. Never commit .env.

# --- Deployment (Render) ---------------------------------------------------
# render.yaml sets these for you; they are listed here so a manual deploy or a
# different host does not miss one.
#   DATABASE_URL            must point at a PERSISTENT volume, e.g.
#                           file:/var/data/intellex/custom.db
#   PORT / HOSTNAME         provided by the platform
#   OPENROUTER_API_KEY, TAVILY_API_KEY   see the Provider keys section below
# See the Deploying section of README.md.
# ---------------------------------------------------------------------------

# --- Provider keys ----------------------------------------------------------
# Two providers, two independent jobs. Either key can be set without the other;
# the flow that needs the missing one fails with a clear message.
#
#   OPENROUTER_API_KEY   chat completions — workflow planning, record
#                        extraction, query expansion. Read straight from the
#                        environment; no credentials file is involved.
#   TAVILY_API_KEY       web search (/search) and page reading (/extract).
#                        Not optional for collection runs: without it the
#                        engine has no way to find or read sources.
#
# Optional:
#   OPENROUTER_MODEL     override the default model slug. Default is
#                        google/gemini-2.5-flash (1M context, $0.30/M in,
#                        $2.50/M out). Any OpenRouter chat model works.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TAVILY_API_KEY=

# Single-tenant access token. The ENTIRE /api surface is gated on this: exchange
# it for an httpOnly session cookie via POST /api/auth/login. While it is unset
# the API returns 503 and the UI shows "Authentication not configured" - it never
# falls back to a default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_TOKEN=

# SQLite file. Relative paths resolve against prisma/schema.prisma, so from the
# repo root use file:../db/custom.db
DATABASE_URL=file:../db/custom.db

# Public origin of this deployment. The /share/<token> page is server-rendered
# and fetches the public share API from this URL, so it must be reachable by the
# Next server itself (not just the browser).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enables scheduled collections. While this is unset the scheduler is DISABLED:
# the HTTP endpoints return 503 and the in-process driver does not start.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULER_KEY=

# The app runs the scheduler itself every 60s while SCHEDULER_KEY is set, so
# scheduled collections fire without any external setup. Set this to 0 when
# running more than one instance and drive /api/scheduler/tick from cron or
# launchd instead (scripts/scheduler-tick.sh), so only one instance ticks.
IN_PROCESS_SCHEDULER=1